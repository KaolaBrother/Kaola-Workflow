{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PLUGIN_ROOT/hooks/kaola-workflow-compact-recovery.md\"",
            "timeout": 5
          }
        ],
        "description": "Inject the generated Claude compact-recovery prompt after context compaction",
        "id": "kaola-workflow:compact-context"
      }
    ]
  }
}
