# Kaola-Workflow Environment Variables
#
# Every variable below is read by a script in this repository, or by the forge CLI the Gitea
# adapter shells out to. A knob with no reader does not belong here.

# Remote call timeout: max milliseconds to wait for GitHub/GitLab/Gitea API responses
# Default 30000 (30 seconds). Set lower in tests to simulate hangs (e.g., 300ms)
# Values above 600000ms (10 minutes) are clamped to 600000ms
# KAOLA_GH_REMOTE_TIMEOUT_MS=30000

# run-chains per-chain kill ceiling: max milliseconds for each spawnSync chain run
# Default 1800000 (30 min); invalid/zero/negative falls back to default; no upper clamp.
# A killed chain records timed_out:true in the receipt.
# KAOLA_RUN_CHAINS_TIMEOUT_MS=1800000

# run-chains parallelism: unset or `auto` picks a pool size from the core count (serial below 8
# cores); `serial` or `1` forces one chain at a time; a positive integer forces that pool size,
# clamped to the number of chains. Any other value falls through to auto rather than failing.
# Set this to `serial` on a host where concurrent chain runs are unstable — a parallel pool can
# take down a long-running git merge inside a chain, which reads as an unexplained chain failure.
# KAOLA_RUN_CHAINS_CONCURRENCY=serial

# Finalize/chain diff base: overrides the integration-branch base used for the changed-paths report
# and for diff-scoped chain selection. Unset means a `main` base, which is byte-equivalent for a
# branch-per-issue run. Set it to a merge-base (or HEAD for an in-place run) so a shared or
# multi-issue branch reports only this run's own diff. The `--base <ref>` flag wins over this.
# KAOLA_FINALIZE_BASE=

# Offline mode: set to 1 to run without forge API access
# KAOLA_WORKFLOW_OFFLINE=0

# Runtime label stamped into workflow-state.md by the claim transaction.
# Equivalent to the `--runtime <label>` flag, which wins when both are given. When neither is set
# the claim infers the label from the environment.
# KAOLA_RUNTIME=

# Worktree-native mode: ON by default — a claim provisions a per-claim repo-local worktree at
# `<repo-root>/.kw/worktrees/<project>/`, one per claimed set (not one per issue) — set to 0 to
# opt out and run on a branch in the repo root.
# Provisioning still requires not-offline + git history; otherwise the claim is a repo-root run.
# The worktree is a tool: decline it and the run still finishes.
# KAOLA_WORKTREE_NATIVE=0

# Co-tenancy declaration: set to 1 when another session is active on this same checkout, so lane
# classification treats every foreign active folder as live and leaves it alone.
# KAOLA_COTENANT=1

# Which issue this run targets. Equivalent to `--target-issue N`.
# KAOLA_TARGET_ISSUE=

# Comma-separated issue numbers for an explicit bundle claim, e.g. 42,47,53. Equivalent to
# `--target-issues 42,47,53`. Must not be set together with KAOLA_TARGET_ISSUE — setting both
# answers target_ambiguity and writes nothing.
# KAOLA_TARGET_ISSUES=

# How this run reaches the default branch: `merge` (the default) or `pr`. Equivalent to
# `--sink merge|pr`, which wins when both are given. Recorded in workflow-state.md at claim time.
# KAOLA_SINK=merge

# Operator-side goal text for this run. Environment variables do not cross the subagent spawn
# boundary, so a goal that must reach a dispatched agent travels in the dispatch prompt instead —
# the orchestrator owns putting it there. Finalization records only that a goal was DECLARED;
# nothing checks whether it was achieved.
# KAOLA_GOAL=

# Dev/test probe: when set, sink-merge writes final CWD to this file on exit
# Not for production use; used by test suite to verify CWD restoration
# KAOLA_WORKFLOW_DEBUG_CWD=

# Test-only: fail first N FF attempts in sink-merge (GitHub, GitLab, and Gitea)
# Used by test suite to verify FF race retry logic (exit code 2)
# KAOLA_WORKFLOW_FORCE_FF_FAIL=

# Test-only: force merge-impossible error in sink-merge (GitHub, GitLab, and Gitea)
# Used by test suite to verify fallback to PR sink logic (exit code 3)
# KAOLA_WORKFLOW_FORCE_MERGE_IMPOSSIBLE=

# Test-only: mock script affordance for testing `gh` command execution in claim and sink-merge scripts
# Used by test suite to inject synthetic `gh` behavior without a live GitHub CLI
# KAOLA_GH_MOCK_SCRIPT=

# Test-only: mock scripts for GitLab and Gitea CLI execution in claim/sink scripts
# KAOLA_GLAB_MOCK_SCRIPT=
# KAOLA_TEA_MOCK_SCRIPT=

# Gitea forge adapter: authentication and server URL for Gitea operations
# Read by the `tea` CLI itself, not by this repository's scripts; required when using the Gitea
# forge adapter (plugins/kaola-workflow-gitea/) unless `tea login add` has been configured instead
# GITEA_TOKEN=<your-gitea-access-token>
# GITEA_SERVER_URL=<gitea-server-url>
